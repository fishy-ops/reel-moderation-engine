MODERATION_BACKEND=nudenet
MODERATION_EXECUTION_PROVIDER=auto
MODERATION_SEMANTIC_BACKEND=none
MODERATION_SEMANTIC_MODE=review
MODERATION_SEMANTIC_MODEL=google/siglip2-base-patch16-224
MODERATION_CLASSIFIER_MODEL=Falconsai/nsfw_image_detection
MODERATION_DERIVED_MEDIA_ROOT=/data/challenges
MODERATION_BATCH_SIZE=8
MODERATION_REVIEW_THRESHOLD=0.42
MODERATION_BLOCK_THRESHOLD=0.82
MAX_UPLOAD_BYTES=536870912
DELETE_INPUTS_AFTER_PROCESSING=true
API_BIND_ADDRESS=127.0.0.1

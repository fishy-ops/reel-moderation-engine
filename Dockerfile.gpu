FROM pytorch/pytorch:2.12.0-cuda13.0-cudnn9-runtime@sha256:c263514402c85b4203311883fbef75cc48c4dcc01bbc65bcd2435348788a34e7

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cusparselt/lib:/usr/local/lib/python3.12/dist-packages/nvidia/nvshmem/lib:/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    HF_HOME=/home/moderator/.cache/huggingface

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/venv

WORKDIR /app
COPY requirements-gpu.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements-gpu.txt \
    && pip install --no-deps 'nudenet==3.4.2' \
    && test "$(pip check 2>&1)" = \
        "nudenet 3.4.2 requires onnxruntime, which is not installed."

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps .

RUN useradd --create-home --uid 10001 moderator \
    && mkdir -p /data/incoming /data/reports /moderation-scratch \
    && chown -R moderator:moderator /data /moderation-scratch

USER moderator
CMD ["rq", "worker", "--worker-class", "rq.worker.SimpleWorker", "--url", "redis://redis:6379/0", "moderation"]

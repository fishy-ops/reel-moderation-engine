FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

WORKDIR /app
COPY requirements-gpu.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements-gpu.txt \
    && pip install --no-deps 'nudenet>=3.4,<4'

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps .

RUN useradd --create-home --uid 10001 moderator \
    && mkdir -p /data/incoming /data/reports /moderation-scratch \
    && chown -R moderator:moderator /data /moderation-scratch

USER moderator
CMD ["rq", "worker", "--url", "redis://redis:6379/0", "moderation"]
